# InnovaFile - configuración local
SECRET_KEY=CAMBIA_ESTA_CLAVE_EN_PRODUCCION
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB=innovafile

# Gemini API - NO pongas esta clave en GitHub ni la compartas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEND_DOCUMENT_CONTENT=true

# Desarrollo local
SESSION_COOKIE_SECURE=false

# Opcional: carpeta local/sincronizada del servidor para documentos almacenados
# UPLOAD_FOLDER=static/uploads/documents
